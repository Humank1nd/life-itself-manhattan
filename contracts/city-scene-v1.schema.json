{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Itself City Scene Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "worldId",
    "frame",
    "layers",
    "assets",
    "assetPolicy",
    "simulation",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "life-itself-city-scene/1.0.0"
    },
    "worldId": {
      "type": "string"
    },
    "frame": {
      "type": "object",
      "required": [
        "crs",
        "origin",
        "units",
        "axes"
      ],
      "properties": {
        "crs": {
          "const": "WGS84"
        },
        "origin": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "elev"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "elev": {
              "type": "number"
            }
          }
        },
        "units": {
          "const": "meters"
        },
        "axes": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "const": "east"
            },
            "y": {
              "const": "up"
            },
            "z": {
              "const": "-north"
            }
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "required": [
        "buildings",
        "streets",
        "anchors",
        "neighborhoods"
      ],
      "properties": {
        "buildings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "count",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^data/[a-z0-9-]+\\.json$"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "idField": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "streets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "count",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^data/[a-z0-9-]+\\.json$"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "idField": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "count",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^data/[a-z0-9-]+\\.json$"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "idField": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "neighborhoods": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "count",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^data/[a-z0-9-]+\\.json$"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "idField": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/evidence-v1.json"
            },
            "kind": {
              "const": "time-indexed-photo-and-business-records"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "photoCatalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/photo-catalog-v1.json"
            },
            "kind": {
              "const": "licensed-metadata-discovery-only"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "photoLinks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/photo-links-v1.json"
            },
            "kind": {
              "const": "unreviewed-spatial-temporal-neighbor-candidates"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "buildingVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/times-square-building-versions-v1.json"
            },
            "kind": {
              "const": "bounded-temporal-building-versions"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "facadeInstances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/facade-instances-v1.json"
            },
            "kind": {
              "const": "unreviewed-panoptic-facade-region-candidates"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "facadeMatches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/facade-matches-v1.json"
            },
            "kind": {
              "const": "conservative-auto-accept-or-abstain"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "facadeCorroboration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/facade-corroboration-v1.json"
            },
            "kind": {
              "const": "independently-evidenced-alignment-observations"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "spatialMemory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/spatial-memory-v1.json"
            },
            "kind": {
              "const": "source-grounded-plane-and-photo-retrieval"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "worldModelPilot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "kind",
            "source"
          ],
          "properties": {
            "uri": {
              "const": "data/lingbot-conditioning-pilot-v1.json"
            },
            "kind": {
              "const": "local-optional-lingbot-packet-not-generated"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri",
          "format",
          "rights",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "format": {
            "enum": [
              "glb",
              "gltf",
              "ktx2"
            ]
          },
          "rights": {
            "enum": [
              "original",
              "public-domain",
              "licensed-for-web"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "assetPolicy": {
      "type": "string"
    },
    "simulation": {
      "type": "object",
      "required": [
        "module",
        "tickMs",
        "seed",
        "journal"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "tickMs": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "journal": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "previous",
        "eventWork"
      ],
      "properties": {
        "previous": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eventWork": {
          "type": "string"
        }
      }
    }
  }
}
